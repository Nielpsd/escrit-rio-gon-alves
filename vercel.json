{
  "buildCommand": "./node_modules/.bin/vite build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/server.js": {
      "includeFiles": "dist/server/**"
    },
    "api/metas.js": {
      "includeFiles": "dist/client/metas/index.html"
    }
  },
  "routes": [
    {
      "src": "/sitemap-blog\\.xml",
      "dest": "/api/sitemap-blog.js"
    },
    {
      "src": "^/metas(/.*)?$",
      "dest": "/api/metas.js"
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/(.+\\.(?:webp|jpg|jpeg|png|gif|svg|ico|woff2?|ttf|otf|eot|mp4|pdf|txt|xml|json))",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/api/server.js"
    }
  ]
}
