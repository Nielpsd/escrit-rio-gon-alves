Options -Indexes

# Cache longo para assets com hash (imutáveis)
<FilesMatch "\.(js|css|woff2?|webp|jpg|png|svg|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML nunca fica em cache
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Página 404 personalizada
ErrorDocument 404 /index.html

# Roteamento SPA
RewriteEngine On
RewriteBase /

# Arquivos e pastas existentes → serve direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Qualquer rota desconhecida → index.html (fallback SPA)
RewriteRule ^ /index.html [L]
